   12          */
   13          int16 Slope_Calculate(uint8 begin, uint8 end, uint8 *border)    //注：begin 必须小于 end,一般 beg
             -in 位于图像上方， end 位于图像下方
   14          {
   15   1          int32 X_Sum = 0, Y_Sum = 0, XY_Sum = 0, X2_Sum = 0;
   16   1          int16 i = 0;
   17   1          int16 Result = 0;
   18   1          static int16 Result_Last;
   19   1        int32 Denominator;
   20   1          if(begin >= end)
   21   1          {
   22   2              return Result_Last;
   23   2          }
   24   1      
   25   1          for(i = begin; i < end ; i++)
   26   1          {
   27   2              X_Sum += i;
   28   2              Y_Sum += border[i];
   29   2              XY_Sum += i * border[i];
   30   2              X2_Sum += i * i;
   31   2          }
   32   1      
   33   1           Denominator = (int32)(end - begin) * X2_Sum - X_Sum * X_Sum;
   34   1          if(Denominator != 0)      //防止为0的情况出现
   35   1          {
   36   2              int32 Numerator = (int32)(end - begin) * XY_Sum - X_Sum * Y_Sum;
   37   2              Result = (int16)( (Numerator * 100) / Denominator );
   38   2              Result_Last = Result;
   39   2          }
   40   1          else
   41   1          {
   42   2              Result = Result_Last;
   43   2          }
   44   1          return Result;
   45   1      }
